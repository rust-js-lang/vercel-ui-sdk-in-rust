+const locale = new Intl.Locale('en-US');
+formatted(locale, new Date(0));
+formatted(['de-DE', locale], 0);
+parts('en-US', 0)[0].type;
+range(0n, new Date(0));
+rangeParts(0, 0)[0].source;
