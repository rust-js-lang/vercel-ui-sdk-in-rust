diff --git a/scripts/mutations/builtins/intl.ts b/scripts/mutations/builtins/intl.ts
new file mode 100644
index 0000000..853052a
--- /dev/null
+++ b/scripts/mutations/builtins/intl.ts
@@ -0,0 +1,51 @@
+// Generator-chain owner mutations; preparation regenerates the canonical
+// binding, then the named real caller test rebuilds its own js metadata.
+import type { Mutation } from "../../mutations";
+const tests = [
+  "test/intl-arguments.test.ts",
+  "-t",
+  "pinned TypeScript argument unions",
+];
+const prepare = [process.execPath, "builtins/intl.ts"];
+export const mutations: Mutation[] = [
+  {
+    name: "intl-locales-without-locale",
+    breaks:
+      "Intl locales stop admitting an Intl.Locale object accepted by the pinned declarations",
+    file: "builtins/intl.ts",
+    find: '"&String", "&Locale", "LocaleElement',
+    replace: '"&String", "LocaleElement',
+    prepare,
+    tests,
+  },
+  {
+    name: "intl-format-without-date",
+    breaks:
+      "formatting stops accepting Date objects from the native Date-or-number union",
+    file: "builtins/intl.ts",
+    find: 'const dateMembers = ["&Date", "f64"];',
+    replace: 'const dateMembers = ["f64"];',
+    prepare,
+    tests,
+  },
+  {
+    name: "intl-ranges-without-bigint",
+    breaks:
+      "format range arguments stop admitting the pinned native bigint form",
+    file: "builtins/intl.ts",
+    find: '[...dateMembers, "&BigInt", "i64", "u64"]',
+    replace: "dateMembers",
+    prepare,
+    tests,
+  },
+  {
+    name: "intl-supported-options-narrowed",
+    breaks:
+      "RelativeTimeFormat supportedLocalesOf loses the native full formatter options type",
+    file: "builtins/intl.ts",
+    find: '{ options: "RelativeTimeFormatOptions", supportedOptions: "constructor" }',
+    replace: '{ options: "RelativeTimeFormatOptions" }',
+    prepare,
+    tests,
+  },
+];
diff --git a/scripts/mutations/typescript/index.ts b/scripts/mutations/typescript/index.ts
new file mode 100644
index 0000000..83ae27f
--- /dev/null
+++ b/scripts/mutations/typescript/index.ts
@@ -0,0 +1,30 @@
+// The TypeScript Member protocol, loaded in the isolated source workspace.
+import type { Mutation } from "../../mutations";
+const tests = ["test/typescript.test.ts", "-t", "construct signatures retain"];
+export const mutations: Mutation[] = [
+  {
+    name: "typescript-construct-unread",
+    breaks:
+      "construct signatures remain opaque source instead of structured parameters and return types",
+    file: "typescript/index.js",
+    find: "case SyntaxKind.ConstructSignature:",
+    replace: "case SyntaxKind.NeverKeyword:",
+    tests,
+  },
+  {
+    name: "typescript-construct-is-call",
+    breaks: "a construct signature is printed as a call signature, losing new",
+    file: "typescript/index.js",
+    find: "return f.createConstructSignatureDeclaration(",
+    replace: "return f.createCallSignatureDeclaration(",
+    tests,
+  },
+  {
+    name: "typescript-member-unknown-accepted",
+    breaks: "the shared Member guard accepts an unknown protocol kind silently",
+    file: "typescript/index.js",
+    find: "throw new Error(`a member isn't one TypeScript is given: ${JSON.stringify(m)}`);",
+    replace: "break;",
+    tests,
+  },
+];
